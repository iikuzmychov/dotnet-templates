<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Net10LibTemplate\Net10LibTemplate.csproj" />
  </ItemGroup>

  <!-- Test runner -->
  <PropertyGroup>

    <!-- Use MTP runner -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- Results directory -->
    <_MtpResultsDirectory>$(ArtifactsPath)/TestResults/$(MSBuildProjectName)</_MtpResultsDirectory>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(_MtpResultsDirectory)"</TestingPlatformCommandLineArguments>

  </PropertyGroup>

</Project>
